use std::cli;
use std::text;
use std::fs;
use numbers;
use settings;

// The UCI archive contains date-ordered, unquoted numeric observations.
fn fail_input(message: str) { stderr_line(message); process_exit(2); }
fn is_training(fields: arglist) -> bool { args_at(fields, 1) < holdout_start() }
fn eligible(fields: arglist) -> bool {
    let weather = args_at(fields, 9);
    weather == "1" || weather == "2" || weather == "3"
}
fn emit_row(fields: arglist) {
    print!(args_at(fields, 5)); print!(","); print!(args_at(fields, 4)); print!(",");
    print!(args_at(fields, 8)); print!(","); print!(args_at(fields, 9)); print!(",");
    print!(text_number(args_at(fields, 10)) * 47.0 - 8.0); print!(",");
    print!(args_at(fields, 3)); print!(","); println!(args_at(fields, 16));
}
fn main() {
    let args = cli_args();
    if args_len(args) < 2 { fail_input("Usage: dataset train hour.csv order.txt | dataset test hour.csv"); }
    let mode = args_at(args, 0);
    let rows = text_lines(read_text(args_at(args, 1)));
    if args_at(rows, 0) != "instant,dteday,season,yr,mnth,hr,holiday,weekday,workingday,weathersit,temp,atemp,hum,windspeed,casual,registered,cnt" {
        fail_input("Unexpected UCI hourly CSV header");
    }
    println!("hour,month,workday,weather,celsius,year_index,count");
    if mode == "train" && args_len(args) == 3 {
        let order = text_lines(read_text(args_at(args, 2)));
        let mut i = 0;
        while i < args_len(order) {
            let id = args_at(order, i);
            let n = floor_integer(text_number(id), 1, args_len(rows) - 1);
            if n < 1 || int_text(n) != id { fail_input("Invalid training observation ID"); }
            let fields = text_split(args_at(rows, n), ",");
            if args_at(fields, 0) != id || !is_training(fields) || !eligible(fields) {
                fail_input("Training order contains an ineligible observation");
            }
            emit_row(fields);
            i += 1;
        }
    } else {
        if mode != "test" || args_len(args) != 2 { fail_input("Expected train or test split"); }
        let mut n = 1;
        while n < args_len(rows) {
            let fields = text_split(args_at(rows, n), ",");
            if !is_training(fields) && eligible(fields) { emit_row(fields); }
            n += 1;
        }
    }
}
