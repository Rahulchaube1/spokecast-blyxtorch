use std::cli;
use std::text;
use forecast;
use numbers;
use presentation;

// Each preset has month, workday, weather and temperature in degrees Celsius.
pub fn preset_json(id: i64) -> str {
    if id == 0 { return "[6,1,1,24]"; }
    if id == 1 { return "[5,0,1,20]"; }
    if id == 2 { return "[10,1,3,12]"; }
    "null"
}

fn scenario_csv(counts: arglist, month: i64, workday: i64, weather: i64, celsius: i64) -> str {
    let mut conditions = args_push(args_new(), int_text(month));
    conditions = args_push(conditions, int_text(workday)); conditions = args_push(conditions, weather_text(weather));
    conditions = args_push(conditions, int_text(celsius)); conditions = args_push(conditions, "2012");
    let suffix = text_concat(",", args_join(conditions, ","));
    let mut lines = args_push(args_new(), "hour_et,estimated_rides,month,workday,weather,temperature_c,network_year");
    let mut h = 0;
    while h < args_len(counts) {
        let pair = text_concat(text_concat(hour_text(h), ","), args_at(counts, h));
        lines = args_push(lines, text_concat(pair, suffix));
        h += 1;
    }
    text_concat(args_join(lines, "\r\n"), "\r\n")
}

// JSON text comes exclusively from validated numbers and fixed display labels.
pub fn daily_forecast(format: i64, month: i64, workday: i64, weather: i64, celsius: i64) -> str {
    if !valid_scenario(month, workday, weather, at([celsius], 0)) || format < 0 || format > 2 { return "null"; }
    let mut counts = args_new();
    let mut total = 0;
    let mut peak = 0;
    let mut peak_hour = 0;
    let mut h = 0;
    while h < 24 {
        let count = nearest_ride(estimate(h, month, workday, weather, at([celsius], 0)));
        counts = args_push(counts, int_text(count));
        total += count;
        if count > peak { peak = count; peak_hour = h; }
        h += 1;
    }
    if format == 1 { return scenario_csv(counts, month, workday, weather, celsius); }
    let mut tick = (peak + 99) / 100 * 25;
    if tick < 25 { tick = 25; }
    let mut json = args_push(args_new(), "{\"counts\":[");
    json = args_push(json, args_join(counts, ","));
    json = args_push(json, "],\"total\":"); json = args_push(json, int_text(total));
    json = args_push(json, ",\"peak\":"); json = args_push(json, int_text(peak));
    json = args_push(json, ",\"peakHour\":"); json = args_push(json, int_text(peak_hour));
    json = args_push(json, ",\"tick\":"); json = args_push(json, int_text(tick));
    json = args_push(json, ",\"summary\":\""); json = args_push(json, scenario_title(month, workday, weather, celsius));
    if format == 0 { return args_join(args_push(json, "\"}"), ""); }
    let mut bars = args_new();
    let mut rows = args_new();
    h = 0;
    while h < 24 {
        let word = args_at(counts, h);
        let count = floor_integer(text_number(word), 0, peak);
        bars = args_push(bars, chart_bar(h, word, grouped_count(count), tick * 4, peak_hour));
        rows = args_push(rows, table_row(h, count));
        h += 1;
    }
    json = args_push(json, "\",\"bars\":\""); json = args_push(json, args_join(bars, ""));
    json = args_push(json, "\",\"table\":\""); json = args_push(json, args_join(rows, ""));
    args_join(args_push(json, "\"}"), "")
}
