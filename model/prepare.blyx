use std::cli;
use std::text;
use std::fs;
use features;
use network;
use numbers;

fn small_integer(word: str) -> i64 {
    let value = text_number(word);
    let n = floor_integer(value, 0, 23);
    if n < 0 || at([n], 0) != value { stderr_line("Invalid scenario field"); process_exit(2); }
    n
}

fn main() {
    let args = cli_args();
    if args_len(args) != 2 { stderr_line("Usage: prepare train|predict raw.csv"); process_exit(2); }
    let mode = args_at(args, 0);
    let labelled = mode == "train";
    if !labelled && mode != "predict" { stderr_line("Unknown encoding mode"); process_exit(2); }
    let rows = text_lines(read_text(args_at(args, 1)));
    if labelled { println!(bt_training_header()); } else { println!(bt_feature_header()); }
    let mut i = 1;
    while i < args_len(rows) {
        let fields = text_split(args_at(rows, i), ",");
        if args_len(fields) != 7 { stderr_line("Invalid scenario row"); process_exit(2); }
        let x = spoke_features(small_integer(args_at(fields, 0)), small_integer(args_at(fields, 1)),
            small_integer(args_at(fields, 2)), small_integer(args_at(fields, 3)), text_number(args_at(fields, 4)),
            small_integer(args_at(fields, 5)));
        let mut k = 0;
        while k < len(x) { if k > 0 { print!(","); } print!(at(x, k)); k += 1; }
        if labelled { print!(","); print!(text_number(args_at(fields, 6)) / count_scale()); }
        println!();
        i += 1;
    }
}
