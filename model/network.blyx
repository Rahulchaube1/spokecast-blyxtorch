fn bt_logits(p: vector, x: vector) -> vector {
    if !btx_valid(p,bt_parameters()) || !btx_valid(x,bt_inputs()) { return []; }
    let a0 = x;
    let a1 = bt_layer0(p, a0);
    if !btx_valid(a1, 16) { return []; }
    let a2 = bt_layer1(p, a1);
    if !btx_valid(a2, 1) { return []; }
    a2
}
pub fn bt_predict(p: vector, x: vector) -> vector {
    let z=bt_logits(p,x); if len(z)==0 { return []; } bt_transform(z)
}
pub fn bt_sample_loss(p: vector, x: vector, t: vector) -> vector {
    if !btx_target_ok(t) { return []; }
    let z=bt_logits(p,x); if len(z)==0 { return []; }
    let cost=btx_cost(z,t); if !btx_finite(cost) { return []; } [cost]
}
pub fn bt_loss_grad(p: vector, x: vector, t: vector) -> vector {
    if !btx_target_ok(t) { return []; }
    if !btx_valid(p,bt_parameters()) || !btx_valid(x,bt_inputs()) { return []; }
    let a0 = x;
    let a1 = bt_layer0(p, a0);
    if !btx_valid(a1, 16) { return []; }
    let a2 = bt_layer1(p, a1);
    if !btx_valid(a2, 1) { return []; }
    let cost = btx_cost(a2,t);
    let d2 = bt_output_delta(a2,t);
    let d1 = [
        btx_pull(d2, p, 512, 16, 0)*btx_relu_slope(at(a1, 0)),
        btx_pull(d2, p, 512, 16, 1)*btx_relu_slope(at(a1, 1)),
        btx_pull(d2, p, 512, 16, 2)*btx_relu_slope(at(a1, 2)),
        btx_pull(d2, p, 512, 16, 3)*btx_relu_slope(at(a1, 3)),
        btx_pull(d2, p, 512, 16, 4)*btx_relu_slope(at(a1, 4)),
        btx_pull(d2, p, 512, 16, 5)*btx_relu_slope(at(a1, 5)),
        btx_pull(d2, p, 512, 16, 6)*btx_relu_slope(at(a1, 6)),
        btx_pull(d2, p, 512, 16, 7)*btx_relu_slope(at(a1, 7)),
        btx_pull(d2, p, 512, 16, 8)*btx_relu_slope(at(a1, 8)),
        btx_pull(d2, p, 512, 16, 9)*btx_relu_slope(at(a1, 9)),
        btx_pull(d2, p, 512, 16, 10)*btx_relu_slope(at(a1, 10)),
        btx_pull(d2, p, 512, 16, 11)*btx_relu_slope(at(a1, 11)),
        btx_pull(d2, p, 512, 16, 12)*btx_relu_slope(at(a1, 12)),
        btx_pull(d2, p, 512, 16, 13)*btx_relu_slope(at(a1, 13)),
        btx_pull(d2, p, 512, 16, 14)*btx_relu_slope(at(a1, 14)),
