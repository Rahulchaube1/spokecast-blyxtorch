use std::cli;
use std::text;
use model::forecast;
use model::numbers;
use model::planner;
use model::checks;

// Stable entry points used by the WebAssembly transport and native CLI.
pub fn predict(hour: i64, month: i64, day: i64, weather: i64, celsius: f64) -> f64 {
    estimate(hour, month, day, weather, celsius)
}
pub fn plan(format: i64, month: i64, day: i64, weather: i64, celsius: i64) -> str {
    daily_forecast(format, month, day, weather, celsius)
}
pub fn preset(id: i64) -> str { preset_json(id) }
pub fn self_test() -> i64 { check_model() }

fn usage() {
    stderr_line("Usage: spokecast forecast|csv MONTH WORKDAY WEATHER TEMPERATURE | spokecast check");
    stderr_line("MONTH 1..12, WORKDAY 0 or 1, WEATHER 1 clear / 2 mist / 3 light rain or snow, TEMPERATURE -8..39 Celsius");
    process_exit(2);
}
fn argument(word: str, low: i64, high: i64) -> i64 {
    if !text_is_number(word) { usage(); }
    let value = text_number(word);
    let integer = floor_integer(value, low, high);
    if integer < low || at([integer], 0) != value { usage(); }
    integer
}
fn main() {
    let args = cli_args();
    if args_len(args) == 1 && args_at(args, 0) == "check" {
        let n = self_test();
        if n != 8640 { stderr_line("Blyx model checks failed"); process_exit(1); }
        print!("Verified hourly predictions: "); println!(n);
        return;
    }
    if args_len(args) != 5 { usage(); }
    let command = args_at(args, 0);
    let mut format = 0;
    if command == "csv" { format = 1; } else { if command != "forecast" { usage(); } }
    let output = plan(format, argument(args_at(args, 1), 1, 12), argument(args_at(args, 2), 0, 1),
        argument(args_at(args, 3), 1, 3), argument(args_at(args, 4), -8, 39));
    if format == 0 { println!(output); } else { print!(output); }
}
